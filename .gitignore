# Personal scan output — contains usernames, account names, timestamps, hits.
# Never publish. Users' own reports stay on their own machines.
findings/
*.report.txt
scan-*.txt
scan-*.json


# Python caches and build junk
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.DS_Store

# The single-file build is a release artifact, regenerated by build/bundle.py.
# Keep it out of source control so the source is the source of truth.
/securail.py
/dist/securail.py

# Windows program build output
/dist/*.exe
/build/pyinstaller/


# Signed release files (uploaded to a GitHub release, not committed)
/release/

# Local review notes
ideas.md

# release gate output
gate-out/

# release artifacts are built, never committed
/dist/